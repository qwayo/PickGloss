{
  "name": "pickgloss",
  "productName": "PickGloss",
  "version": "0.1.14",
  "private": true,
  "license": "MIT",
  "description": "Windows 划词与截图解释助手",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/core/*.test.cjs tests/windows/*.test.cjs tests/renderer/*.test.cjs",
    "build:native": "node scripts/build-native.cjs",
    "package": "node scripts/package.cjs",
    "smoke": "electron . --smoke-test",
    "test:host": "electron scripts/electron-contract.cjs",
    "test:interaction": "electron scripts/check-streaming-controls.cjs",
    "test:markdown": "electron scripts/check-markdown.cjs",
    "check:publication": "node scripts/check-publication-hygiene.cjs",
    "check:script-encoding": "node scripts/check-script-encoding.cjs",
    "test:composer": "electron scripts/check-composer-flow.cjs",
    "test:screenshot-translation": "electron scripts/check-screenshot-translation.cjs",
    "test:history-settings": "electron scripts/check-history-settings-ui.cjs",
    "test:reading": "electron scripts/check-reading-layout.cjs",
    "check:ui": "node scripts/check-ui.cjs",
    "check:native-edges": "electron scripts/check-native-edges.cjs",
    "check:portable": "node scripts/check-portable-suite.cjs"
  },
  "dependencies": {
    "markdown-it": "15.0.3",
    "selection-hook": "2.1.2"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "acorn": "8.19.0",
    "electron": "44.9.0"
  }
}
